{
  "$id": "https://dots.dev/schemas/dots-questions.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "data": {
      "properties": {
        "questions": {
          "items": {
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "setting"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "required": [
                    "package",
                    "key",
                    "type",
                    "secret",
                    "reason"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "bundle",
                        "tag"
                      ]
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "properties": {
                    "recommended": {
                      "const": true
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "secret": {
                      "const": true
                    }
                  },
                  "required": [
                    "secret"
                  ]
                },
                "then": {
                  "properties": {
                    "recommended": {
                      "type": "null"
                    }
                  }
                }
              }
            ],
            "properties": {
              "answer": {
                "type": "string"
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "id": {
                "pattern": "^(setting|bundle|tag):",
                "type": "string"
              },
              "key": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "setting",
                  "bundle",
                  "tag"
                ]
              },
              "name": {
                "type": "string"
              },
              "package": {
                "type": "string"
              },
              "question": {
                "type": "string"
              },
              "reason": {
                "enum": [
                  "ask",
                  "required"
                ]
              },
              "recommended": {},
              "required": {
                "type": "boolean"
              },
              "secret": {
                "type": "boolean"
              },
              "type": {
                "type": "string"
              },
              "values": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "id",
              "kind",
              "name",
              "question",
              "required",
              "recommended",
              "answer"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "required_unanswered": {
          "minimum": 0,
          "type": "integer"
        },
        "unanswered": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "questions",
        "unanswered",
        "required_unanswered"
      ],
      "type": "object"
    },
    "errors": {
      "items": {
        "properties": {
          "code": {
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "provenance": {
            "items": {
              "properties": {
                "col": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "file": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "line": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "source"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "code",
          "message",
          "hint",
          "provenance"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "ok": {
      "type": "boolean"
    },
    "schema": {
      "const": "dots/questions@1"
    },
    "warnings": {
      "items": {
        "properties": {
          "code": {
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "provenance": {
            "items": {
              "properties": {
                "col": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "file": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "line": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "source"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "code",
          "message",
          "hint",
          "provenance"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "ok",
    "data",
    "warnings",
    "errors"
  ],
  "title": "dots questions --json (schema version 1)",
  "type": "object"
}
