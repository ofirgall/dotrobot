{
  "$id": "https://dots.dev/schemas/dots-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "data": {
      "properties": {
        "batches": {
          "items": {
            "properties": {
              "after": {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              "commands": {
                "items": {
                  "properties": {
                    "argv": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "needs_root": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "argv",
                    "needs_root"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "id": {
                "minimum": 0,
                "type": "integer"
              },
              "interactive": {
                "type": "boolean"
              },
              "packages": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "provider": {
                "type": "string"
              },
              "sudo": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "provider",
              "packages",
              "interactive",
              "after",
              "commands"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "empty": {
          "type": "boolean"
        },
        "files": {
          "items": {
            "properties": {
              "detail": {
                "type": "string"
              },
              "dst": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "owned": {
                "type": "boolean"
              },
              "package": {
                "type": "string"
              }
            },
            "required": [
              "package",
              "dst",
              "kind",
              "detail",
              "owned"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "hooks": {
          "items": {
            "properties": {
              "command": {
                "type": "string"
              },
              "event": {
                "enum": [
                  "pre_install",
                  "post_install",
                  "pre_files",
                  "post_files"
                ]
              },
              "package": {
                "type": "string"
              },
              "why": {
                "type": "string"
              }
            },
            "required": [
              "package",
              "event",
              "command",
              "why"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "lock": {
          "description": "dots.lock rows that change or drift (present only when there are any)",
          "items": {
            "properties": {
              "drift": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "from": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "package": {
                "type": "string"
              },
              "platform": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "rewrite": {
                "type": "boolean"
              },
              "to": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "package",
              "provider",
              "platform",
              "from",
              "to",
              "rewrite",
              "drift"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "services": {
          "items": {
            "properties": {
              "action": {
                "type": "string"
              },
              "commands": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "detail": {
                "type": "string"
              },
              "manager": {
                "enum": [
                  "brew",
                  "launchd",
                  "systemd-user",
                  "windows-startup"
                ]
              },
              "name": {
                "type": "string"
              },
              "package": {
                "type": "string"
              }
            },
            "required": [
              "package",
              "name",
              "manager",
              "action",
              "detail",
              "commands"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "settings": {
          "items": {
            "properties": {
              "action": {
                "enum": [
                  "set",
                  "restore",
                  "delete"
                ]
              },
              "detail": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "defaults",
                  "registry",
                  "xdg"
                ]
              },
              "label": {
                "type": "string"
              },
              "package": {
                "type": "string"
              },
              "requires": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "restart": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "root": {
                "type": "boolean"
              }
            },
            "required": [
              "package",
              "id",
              "label",
              "kind",
              "action",
              "detail",
              "root",
              "restart",
              "requires"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "shims": {
          "items": {
            "properties": {
              "action": {
                "enum": [
                  "create",
                  "update",
                  "remove"
                ]
              },
              "dst": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "package": {
                "type": "string"
              },
              "target": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "package",
              "name",
              "dst",
              "action",
              "target"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "steps": {
          "items": {
            "properties": {
              "action": {
                "enum": [
                  "install",
                  "upgrade",
                  "downgrade"
                ]
              },
              "after": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "batch": {
                "minimum": 0,
                "type": "integer"
              },
              "bootstrap": {
                "type": "boolean"
              },
              "from": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "interactive": {
                "type": "boolean"
              },
              "name": {
                "type": "string"
              },
              "needs_root": {
                "type": "boolean"
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "package": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "replaces": {
                "properties": {
                  "commands": {
                    "items": {
                      "properties": {
                        "argv": {
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        },
                        "needs_root": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "argv",
                        "needs_root"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "keep": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "name": {
                    "type": "string"
                  },
                  "provider": {
                    "type": "string"
                  },
                  "removes": {
                    "type": "boolean"
                  },
                  "version": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "provider",
                  "name",
                  "version",
                  "removes",
                  "keep",
                  "commands"
                ],
                "type": "object"
              },
              "sudo": {
                "description": "why a plain `dots apply` skips this step (`requires_sudo`, `needs_root`, ...); null for an ordinary step",
                "type": [
                  "string",
                  "null"
                ]
              },
              "to": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "package",
              "provider",
              "name",
              "action",
              "from",
              "to",
              "needs_root",
              "interactive",
              "bootstrap",
              "batch",
              "after"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "summary": {
          "properties": {
            "downgrades": {
              "minimum": 0,
              "type": "integer"
            },
            "files": {
              "minimum": 0,
              "type": "integer"
            },
            "hooks": {
              "minimum": 0,
              "type": "integer"
            },
            "packages": {
              "minimum": 0,
              "type": "integer"
            },
            "root_actions": {
              "minimum": 0,
              "type": "integer"
            },
            "services": {
              "minimum": 0,
              "type": "integer"
            },
            "settings": {
              "minimum": 0,
              "type": "integer"
            },
            "shims": {
              "minimum": 0,
              "type": "integer"
            },
            "sudo_steps": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "packages",
            "files",
            "settings",
            "services",
            "shims",
            "hooks",
            "downgrades",
            "root_actions"
          ],
          "type": "object"
        },
        "unplanned": {
          "items": {
            "properties": {
              "package": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "package",
              "reason"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "empty",
        "steps",
        "batches",
        "files",
        "settings",
        "services",
        "shims",
        "hooks",
        "unplanned",
        "summary"
      ],
      "type": "object"
    },
    "errors": {
      "items": {
        "properties": {
          "code": {
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "provenance": {
            "items": {
              "properties": {
                "col": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "file": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "line": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "source"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "code",
          "message",
          "hint",
          "provenance"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "ok": {
      "type": "boolean"
    },
    "schema": {
      "const": "dots/plan@1"
    },
    "warnings": {
      "items": {
        "properties": {
          "code": {
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "provenance": {
            "items": {
              "properties": {
                "col": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "file": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "line": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "source"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "code",
          "message",
          "hint",
          "provenance"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "ok",
    "data",
    "warnings",
    "errors"
  ],
  "title": "dots plan --json (schema version 1)",
  "type": "object"
}
