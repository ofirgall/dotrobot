{
  "$id": "https://dots.dev/schemas/dots-migrate.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "data": {
      "properties": {
        "changed": {
          "type": "boolean"
        },
        "file": {
          "type": "string"
        },
        "from": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "installed": {
          "type": "boolean"
        },
        "lock": {
          "type": "boolean"
        },
        "package": {
          "type": "string"
        },
        "removed": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "steps": {
          "items": {
            "properties": {
              "action": {
                "enum": [
                  "install",
                  "remove"
                ]
              },
              "commands": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "provider": {
                "type": "string"
              }
            },
            "required": [
              "provider",
              "action",
              "commands"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "to": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "errors": {
      "items": {
        "properties": {
          "code": {
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "provenance": {
            "items": {
              "properties": {
                "col": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "file": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "line": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "source"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "code",
          "message",
          "hint",
          "provenance"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "ok": {
      "type": "boolean"
    },
    "schema": {
      "const": "dots/migrate@1"
    },
    "warnings": {
      "items": {
        "properties": {
          "code": {
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "provenance": {
            "items": {
              "properties": {
                "col": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "file": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "line": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "source"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "code",
          "message",
          "hint",
          "provenance"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "ok",
    "data",
    "warnings",
    "errors"
  ],
  "title": "dots migrate --json (schema version 1)",
  "type": "object"
}
