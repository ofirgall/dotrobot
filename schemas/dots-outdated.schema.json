{
  "$id": "https://dots.dev/schemas/dots-outdated.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "data": {
      "properties": {
        "offline": {
          "type": "boolean"
        },
        "outdated": {
          "minimum": 0,
          "type": "integer"
        },
        "packages": {
          "items": {
            "properties": {
              "installed": {
                "type": "string"
              },
              "latest": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "package": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "state": {
                "enum": [
                  "ok",
                  "outdated",
                  null
                ]
              },
              "wanted": {
                "type": "string"
              }
            },
            "required": [
              "package",
              "provider",
              "wanted",
              "installed",
              "latest",
              "state"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "refreshed": {
          "type": "boolean"
        },
        "unknown": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "offline",
        "refreshed",
        "packages",
        "outdated",
        "unknown"
      ],
      "type": "object"
    },
    "errors": {
      "items": {
        "properties": {
          "code": {
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "provenance": {
            "items": {
              "properties": {
                "col": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "file": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "line": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "source"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "code",
          "message",
          "hint",
          "provenance"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "ok": {
      "type": "boolean"
    },
    "schema": {
      "const": "dots/outdated@1"
    },
    "warnings": {
      "items": {
        "properties": {
          "code": {
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "provenance": {
            "items": {
              "properties": {
                "col": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "file": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "line": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "source"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "code",
          "message",
          "hint",
          "provenance"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "ok",
    "data",
    "warnings",
    "errors"
  ],
  "title": "dots outdated --json (schema version 1)",
  "type": "object"
}
