{
  "$id": "https://dots.dev/schemas/dots-facts.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "data": {
      "properties": {
        "arch": {
          "type": "string"
        },
        "facts": {
          "additionalProperties": {
            "properties": {
              "detail": {
                "type": "string"
              },
              "source": {
                "enum": [
                  "detected",
                  "overridden",
                  "declared"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "boolean",
                  "number"
                ]
              }
            },
            "required": [
              "value",
              "source"
            ],
            "type": "object"
          },
          "type": "object"
        },
        "platform_chain": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "facts",
        "platform_chain",
        "arch",
        "tags"
      ],
      "type": "object"
    },
    "errors": {
      "items": {
        "properties": {
          "code": {
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "provenance": {
            "items": {
              "properties": {
                "col": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "file": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "line": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "source"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "code",
          "message",
          "hint",
          "provenance"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "ok": {
      "type": "boolean"
    },
    "schema": {
      "const": "dots/facts@1"
    },
    "warnings": {
      "items": {
        "properties": {
          "code": {
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "provenance": {
            "items": {
              "properties": {
                "col": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "file": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "line": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "source"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "code",
          "message",
          "hint",
          "provenance"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "ok",
    "data",
    "warnings",
    "errors"
  ],
  "title": "dots facts --json (schema version 1)",
  "type": "object"
