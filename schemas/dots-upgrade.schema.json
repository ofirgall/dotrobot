                    "type": "string"
                  },
                  "package": {
                    "type": "string"
                  },
                  "provider": {
                    "type": "string"
                  },
                  "to": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "package",
                  "provider",
                  "from",
                  "to"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
