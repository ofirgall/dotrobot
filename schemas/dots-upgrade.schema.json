                  ]
                },
                "file": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "line": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "source"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "code",
          "message",
          "hint",
          "provenance"
