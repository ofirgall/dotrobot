{
  "$id": "https://dots.dev/schemas/dots-upgrade.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "data": {
      "properties": {
        "upgrade": {
          "properties": {
            "commit": {
              "type": [
                "string",
                "null"
              ]
            },
            "skipped": {
              "items": {
                "properties": {
                  "package": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  }
