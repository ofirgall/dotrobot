                    "string",
                    "null"
                  ]
                },
                "line": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "source"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "code",
          "message",
          "hint",
          "provenance"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "ok": {
      "type": "boolean"
    },
    "schema": {
      "const": "dots/upgrade@1"
    },
    "warnings": {
      "items": {
        "properties": {
          "code": {
